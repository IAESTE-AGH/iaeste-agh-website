---
import { ThemedLink, ThemedText } from '@/atoms';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { Image } from 'astro:assets';
import img_7 from '@/assets/images/img_7.png';
import img_13 from '@/assets/images/img_13.png';
import img_4 from '@/assets/images/img_4.png';

const url = new URL(Astro.request.url);
const lang = getLangFromUrl(url);
const t = useTranslations(lang);
---

<section id="landing">
    <div class="text-section">
        {
            t('landing.slogan')
                .split(' ')
                .map(word => (
                    <ThemedText variant="h1" bold class="gradient-text">
                        {word}
                    </ThemedText>
                ))
        }
        <ThemedLink button href="#" variant="h5"> Dołącz do nas! </ThemedLink>
    </div>
    <div class="double-photo">
        <Image src={img_4} alt="IAESTE group photo" />
        <Image src={img_13} alt="IAESTE group selfie" />
    </div>
    <div class="single-photo">
        <Image src={img_7} alt="IAESTE group selfie" />
    </div>
</section>

<style>
    #landing {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-rows: 100%;
        gap: var(--spacing-md);
        height: calc(100svh - 32px - 32px - 32px - 106px);
        min-height: 500px;
        max-height: 850px;
    }

    .text-section {
        padding: var(--spacing-lg);
        border: var(--border);
        border-radius: var(--borderRadius-default);
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
    }

    .double-photo {
        display: grid;
        grid-template-rows: 1fr 1fr;
        gap: var(--spacing-md);
        height: 100%;
    }

    .single-photo {
        height: 100%;
    }

    img {
        border: var(--border);
        height: 100%;
        width: 100%;
        border-radius: var(--borderRadius-default);
        object-fit: cover;
        box-shadow: var(--shadows-default);
    }

    @media (max-width: 768px) {
        #landing {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-md);
            height: fit-content;
        }

        .double-photo {
            display: none;
        }
    }
</style>
